<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Copyleaks.SDK.V3.API</RootNamespace>
    <AssemblyName>CopyleaksAPIV3</AssemblyName>
    <Authors>Copyleaks LTD</Authors>
    <Company>Copyleaks LTD</Company>
    <Product>Copyleaks</Product>
    <Description>The official Copyleaks .NET SDK for AI Text Detection, AI Image Detection, AI Video Detection, Plagiarism Checker, Image Plagiarism Detection, Grammar Checker and Text Moderation.</Description>
    <Copyright>Copyright (c) Copyleaks Ltd.</Copyright>
    <PackageId>Copyleaks</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://copyleaks.com/</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/Copyleaks/.net-core-plagiarism-checker/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/Copyleaks/.net-core-plagiarism-checker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>plagiarism copyright copyrights Copyleaks infringement checker detector ai-text-detection ai-image-detection ai-video-detection image-plagiarism grammar-checker text-moderation</PackageTags>
    <Version>5.0.0</Version>
    <AssemblyVersion>5.0.0</AssemblyVersion>
    <FileVersion>5.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every public member has an XML comment yet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
